{
  "name": "studyflow-fullstack-backend",
  "version": "2.0.0",
  "private": true,
  "description": "API REST para StudyFlow Full Stack - Entrega final del reto",
  "main": "src/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "debug": "node --inspect src/server.js",
    "check": "node --check src/server.js && node --check src/app.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand tests/unit",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "jest": "^30.0.0",
    "supertest": "^7.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": ["<rootDir>/tests/setupEnv.js"],
    "testTimeout": 20000
  }
}
