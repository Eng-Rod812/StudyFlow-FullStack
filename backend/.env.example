# Copia este archivo como backend/.env; nunca lo subas a GitHub.
NODE_ENV=development
PORT=3000
# PostgreSQL local: cambia usuario, contraseña y BD por tus valores.
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/studyflow
# Para servicios cloud agrega ?sslmode=require a DATABASE_URL cuando lo indiquen.
JWT_SECRET=REEMPLAZA_CON_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRES_IN=2h
# Si el frontend es servido por Express, se puede dejar vacío.
CORS_ORIGIN=
